<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="add_job"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_add"
        android:shortcutShortLabel="@string/shortcut_add_job"
        android:shortcutLongLabel="@string/shortcut_add_job_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.pamneuroncraft.jobapplicationtracker"
            android:targetClass="com.pamneuroncraft.jobapplicationtracker.MainActivity">
            <extra android:name="shortcut" android:value="add_job" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="view_summary"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_summary"
        android:shortcutShortLabel="@string/shortcut_summary"
        android:shortcutLongLabel="@string/shortcut_summary_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.pamneuroncraft.jobapplicationtracker"
            android:targetClass="com.pamneuroncraft.jobapplicationtracker.MainActivity">
            <extra android:name="shortcut" android:value="summary" />
        </intent>
    </shortcut>
</shortcuts>
